ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://kufinder:kufinder@localhost:5432/kufinder
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# local 또는 s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=

HIGH_CONFIDENCE_THRESHOLD=0.80
MINIMUM_MATCH_SCORE=0.35
MATCH_CANDIDATE_LIMIT=200
MATCH_RESULT_LIMIT=10
