# RDS 연결 주소
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@RDS_ENDPOINT:5432/DB_NAME

# 프론트 허용 주소
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 이미지 저장 방식: local 또는 s3
# local 사용 시: STORAGE_BACKEND=local, LOCAL_STORAGE_PATH=./uploads
STORAGE_BACKEND=s3
LOCAL_STORAGE_PATH=./uploads

# S3 설정
S3_BUCKET=YOUR_BUCKET_NAME
S3_REGION=ap-northeast-2
S3_PUBLIC_BASE_URL=https://YOUR_BUCKET_NAME.s3.ap-northeast-2.amazonaws.com

# 로컬 개발용 AWS 키
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=ap-northeast-2

# VLM 이미지 매칭
VLM_ENABLED=false
VLM_MODEL_NAME=jinaai/jina-clip-v2
VLM_SCORE_WEIGHT=0.45
VLM_MATCH_WAIT_SECONDS=20

# Admin
ADMIN_PASSWORD=change-this-password
ADMIN_TOKEN_SECRET=change-this-long-random-secret
ADMIN_SESSION_MINUTES=480

# Item retention
ITEM_RETENTION_DAYS=30
EXPIRED_ITEM_CLEANUP_INTERVAL_SECONDS=21600

